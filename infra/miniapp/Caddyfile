:8080 {
  root * /srv
  encode zstd gzip
  try_files {path} /index.html
  file_server

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-Robots-Tag "noindex, nofollow"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  }

  @html path / /index.html
  header @html Cache-Control "no-cache"

  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"

  @media path *.jpg *.jpeg *.png *.webp
  header @media Cache-Control "public, max-age=2592000, immutable"
}
