NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost
APP_DOMAIN=localhost

DATABASE_URL=postgresql://personal_brand:change-me@postgres:5432/personal_brand
REDIS_URL=redis://redis:6379
POSTGRES_DB=personal_brand
POSTGRES_USER=personal_brand
POSTGRES_PASSWORD=change-me

# Server-only Telegram credentials. Leave empty for local UI and test work.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EXPERT_TELEGRAM_IDS=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# Server-only Meta/Threads credentials. Dry-run stays enabled by default.
THREADS_API_BASE_URL=https://graph.threads.net
THREADS_API_VERSION=v1.0
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_DRY_RUN=true

# Server-only AI and discovery credentials. External discovery is disabled.
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5.6-luna
OPENAI_WRITER_MODEL=gpt-5.6-terra
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_WEBHOOK_SECRET=
APIFY_MARKET_ENABLED=false
APIFY_DAILY_MAX_RESULTS=100
APIFY_TEST_RUN_LIMIT=9
APIFY_MAX_CHARGE_USD=0.5

APP_ENCRYPTION_KEY=
