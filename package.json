{
  "name": "personal-brand-threads-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Telegram approval and Threads publishing template for a personal brand",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:miniapp": "npm --prefix miniapp run build",
    "dev": "tsx watch src/main.ts",
    "dev:miniapp": "npm --prefix miniapp run dev",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file=.env src/infrastructure/database/migrate.ts",
    "db:migrate:prod": "node dist/infrastructure/database/migrate.js",
    "telegram:set-webhook": "node --env-file-if-exists=.env scripts/register-telegram-webhook.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "bullmq": "6.3.4",
    "fastify": "5.12.1",
    "grammy": "1.46.0",
    "ioredis": "6.0.0",
    "openai": "7.9.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
